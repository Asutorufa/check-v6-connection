#!/bin/sh

case "$SSH_ORIGINAL_COMMAND" in
  "probe")
    lan_source="$(ip -6 -o addr show dev br-lan scope global 2>/dev/null \
      | awk '$4 !~ /^fd/ && $0 !~ /deprecated/ { sub("/.*", "", $4); print $4; exit }')"
    if [ -z "$lan_source" ]; then
      logger -t ipv6-watch-ssh "No usable global IPv6 address on br-lan"
      exit 2
    fi
    exec ping6 -I "$lan_source" -c 1 -W 3 openwrt.org
    ;;

  "recover")
    exec ifup wan6
    ;;

  *)
    logger -t ipv6-watch-ssh "Rejected SSH command"
    exit 126
    ;;
esac
